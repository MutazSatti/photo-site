# ==============================================================
# قالب إعدادات الإنتاج — انسخه إلى .env على الخادم ثم عدّل القيم
# المعلّمة بـ «‼️ غيّرني». لا ترفع هذا الملف بعد تعبئته إلى git.
# ==============================================================

APP_NAME="معتز ساتي"
APP_ENV=production
APP_KEY=                        # ‼️ يُولَّد بـ: php artisan key:generate
APP_DEBUG=false                 # ‼️ يجب أن يبقى false على الإنتاج
APP_URL=https://mutazsatti.com
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# سجلات أخف على الإنتاج + تدوير يومي
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# قاعدة البيانات — SQLite بمسار مطلق
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/mutazsatti.com/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.mutazsatti.com
SESSION_SECURE_COOKIE=true      # الكوكيز عبر HTTPS فقط

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# البريد — مطلوب لوصول رسائل نموذج «اتصل بنا»
# ‼️ استبدل ببيانات مزوّدك (Mailgun / Postmark / Resend / SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=                  # ‼️ غيّرني
MAIL_PASSWORD=                  # ‼️ غيّرني
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@mutazsatti.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# بيانات المصور — تظهر في Schema.org وصفحة التواصل
SITE_OWNER_NAME="معتز ساتي"
SITE_OWNER_NAME_EN="Mutaz Satti"
SITE_PHONE="+966556202624"
SITE_PHONE_LOCAL="0556202624"
SITE_WHATSAPP="966556202624"
SITE_EMAIL="Mutaz4st@gmail.com"
SITE_HANDLE="mutaz_satti"
SITE_CITY="جدة"
SITE_CITY_EN="Jeddah"
SITE_REGION="مكة المكرمة"
SITE_COUNTRY="SA"
SITE_LATITUDE=21.485811
SITE_LONGITUDE=39.192505

# لوحة التحكم على /admin
ADMIN_EMAIL=                    # ‼️ بريدك الحقيقي
ADMIN_PASSWORD=                 # ‼️ كلمة مرور قوية — لا تترك change-me
